{
  "name": "retro-composer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "file-saver": "^2.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tone": "^15.1.22",
    "uuid": "^14.0.2"
  },
  "homepage": "https://retro.kuk.is",
  "scripts": {
